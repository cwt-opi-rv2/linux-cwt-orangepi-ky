[Trigger]
Type = File
Operation = Install
Operation = Upgrade
Target = boot/vmlinux
Target = usr/lib/initcpio/*

[Action]
Description = Updating linux initcpios...
When = PostTransaction
Exec = /bin/sh -c '/usr/bin/mkinitcpio -p linux -k 6.6.75-cwt1-v6.6.ky-1 && mkimage -A riscv -O linux -T ramdisk -C gzip -n uInitrd -d /boot/initramfs-linux.img /boot/uInitrd.img'
