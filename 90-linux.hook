[Trigger]
Type = File
Operation = Install
Operation = Upgrade
Target = boot/vmlinuz-6.6.75-cwt1-v6.6.ky-3
Target = usr/lib/initcpio/*

[Action]
Description = Updating linux initcpios...
When = PostTransaction
Exec = /bin/sh -c 'KVER=6.6.75-cwt1-v6.6.ky-3 && /usr/bin/mkinitcpio -p linux -k $KVER && ln -sf vmlinuz-$KVER /boot/vmlinuz && ln -sf initramfs.img-$KVER /boot/initramfs.img'
